{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cerberus workflow proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "automations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "string"
    },
    "automations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "kind",
          "provider",
          "prompt",
          "enabled",
          "repositoryIds"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "commitBranch": {
            "type": "string"
          },
          "handoffName": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "reasoningEffort": {
            "type": "string"
          },
          "feedbackFolder": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "repositoryIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "handoffVariables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "emitsHandoffs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "feedbackPath": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "includeFutureRepositories": {
            "type": "boolean"
          },
          "runtimeTarget": {
            "type": "boolean"
          },
          "commitAllExcept": {
            "type": "boolean"
          },
          "requiresMailbox": {
            "type": "boolean"
          },
          "inboxBatch": {
            "type": "boolean"
          },
          "handoffOnly": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "prompt",
              "shell",
              "notification",
              "git"
            ]
          },
          "provider": {
            "enum": [
              "codex",
              "cursor",
              "copilot",
              "claude"
            ]
          },
          "mode": {
            "enum": [
              "analyze",
              "edit"
            ]
          },
          "gitAction": {
            "enum": [
              "fetch",
              "pull",
              "push",
              "stage",
              "unstage",
              "commit"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "minutes": {
            "type": "number",
            "minimum": 1
          },
          "debounceSeconds": {
            "type": "number",
            "minimum": 0
          },
          "changeThreshold": {
            "type": "number",
            "minimum": 0
          },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "feedback",
                "manual",
                "interval",
                "afterIdle",
                "fileChange",
                "changeCount",
                "commit",
                "ciPass",
                "ciFail",
                "handoff",
                "idleTime",
                "push",
                "pullRequest"
              ]
            }
          },
          "conditionSets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "feedback",
                  "manual",
                  "interval",
                  "afterIdle",
                  "fileChange",
                  "changeCount",
                  "commit",
                  "ciPass",
                  "ciFail",
                  "handoff",
                  "idleTime",
                  "push",
                  "pullRequest"
                ]
              }
            }
          },
          "scriptRuntime": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "preset"
            ],
            "properties": {
              "preset": {
                "enum": [
                  "auto",
                  "default",
                  "bash",
                  "powershell",
                  "python",
                  "node",
                  "ruby",
                  "custom"
                ]
              },
              "executable": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "extension": {
                "type": "string"
              }
            }
          },
          "manualInputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "text",
                    "number",
                    "boolean",
                    "choice"
                  ]
                },
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "defaultValue": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "emailRecipient": {
            "type": "string"
          },
          "emailPriority": {
            "type": "integer",
            "minimum": 1
          }
        },
        "anyOf": [
          {
            "required": [
              "conditions"
            ]
          },
          {
            "required": [
              "conditionSets"
            ]
          }
        ]
      }
    }
  }
}
