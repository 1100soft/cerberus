{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitCerberus",
  "version": "0.1.0",
  "identifier": "dev.gitcerberus.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "GitCerberus", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 620 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
